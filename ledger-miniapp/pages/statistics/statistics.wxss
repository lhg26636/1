/* ===== 顶栏 ===== */
.top-bar {
  display: flex; justify-content: space-between; align-items: center;
  padding: 28rpx 60rpx; background: var(--card);
}
.tb-arrow { font-size: 30rpx; color: var(--text-hint); padding: 10rpx 18rpx; transition: color .2s; }
.tb-arrow:active { color: var(--text); }
.tb-center { display: flex; flex-direction: column; align-items: center; }
.tb-title { font-size: 34rpx; font-weight: 700; color: var(--text); }
.tb-today {
  font-size: 22rpx; color: var(--primary-light);
  background: var(--primary-bg); padding: 2rpx 20rpx;
  border-radius: var(--radius-full); margin-top: 2rpx;
}

/* ===== 月度总览 ===== */
.overview-card {
  display: flex; align-items: center; justify-content: space-around;
  margin: 16rpx 20rpx 0; padding: 28rpx 20rpx;
  background: linear-gradient(135deg, #1B5E20, #2E7D32);
  border-radius: var(--radius); box-shadow: var(--shadow);
  animation: fadeInUp .4s var(--ease-out) both;
}
.ov-item { display: flex; flex-direction: column; align-items: center; gap: 6rpx; flex: 1; min-width: 0; }
.ov-label { font-size: 24rpx; color: rgba(255,255,255,.7); }
.ov-val { font-size: 30rpx; font-weight: 800; max-width: 100%; word-break: break-all; color: #fff; }
.ov-val.income-text { color: #C8E6C9; }
.ov-val.expense-text { color: #FFCDD2; }
.ov-divider { width: 2rpx; height: 40rpx; background: rgba(255,255,255,.15); }

/* ===== 视图切换 ===== */
.vtabs {
  display: flex; margin: 16rpx 20rpx 0;
  background: var(--card); border-radius: var(--radius-sm);
  overflow: hidden; box-shadow: var(--shadow-xs);
}
.vt {
  flex: 1; text-align: center; padding: 24rpx;
  font-size: 28rpx; color: var(--text-hint); position: relative;
  transition: all .3s var(--ease);
}
.vt-on { color: var(--primary-light); font-weight: 700; }
.vt-on::after {
  content: ''; position: absolute; bottom: 6rpx; left: 30%; right: 30%;
  height: 4rpx; background: var(--primary-mid); border-radius: 2rpx;
  transition: all .3s var(--ease);
}

/* ===== 分类 Tab ===== */
.ttabs { display: flex; margin: 16rpx 20rpx 0; gap: 14rpx; }
.tt {
  flex: 1; text-align: center; padding: 18rpx;
  background: var(--card); border-radius: var(--radius-sm);
  font-size: 27rpx; color: var(--text-hint);
  transition: all .3s var(--ease);
  box-shadow: var(--shadow-xs);
}
.tt:active { transform: scale(.96); }
.tt-expense {
  background: linear-gradient(135deg, #C62828, #D32F2F);
  color: #fff; font-weight: 700;
  box-shadow: 0 4rpx 16rpx rgba(198,40,40,.2);
}
.tt-income {
  background: linear-gradient(135deg, var(--primary-light), var(--primary-mid));
  color: #fff; font-weight: 700;
  box-shadow: 0 4rpx 16rpx rgba(46,125,50,.2);
}

/* ===== 分类排行 ===== */
.stat-item {
  display: flex; align-items: center; justify-content: space-between;
  padding: 20rpx 0; transition: background .2s;
}
.stat-item:active { background: var(--card-hover); margin: 0 -28rpx; padding: 20rpx 28rpx; border-radius: var(--radius-sm); }
.stat-item + .stat-item { border-top: 1rpx solid var(--divider); }
.si-left { display: flex; align-items: center; gap: 16rpx; flex: 1; min-width: 0; margin-right: 20rpx; }
.si-icon { font-size: 36rpx; width: 50rpx; text-align: center; flex-shrink: 0; }
.si-info { flex: 1; min-width: 0; }
.si-name { font-size: 28rpx; font-weight: 600; margin-bottom: 8rpx; display: block; }
.si-bar { height: 10rpx; background: var(--divider); border-radius: 5rpx; overflow: hidden; }
.si-fill { height: 100%; border-radius: 5rpx; transition: width .6s var(--ease-out); }
.expense-fill { background: linear-gradient(90deg, #FF5252, #FF8A80); }
.income-fill { background: linear-gradient(90deg, #4CAF50, #A5D6A7); }
.si-right { text-align: right; display: flex; flex-direction: column; gap: 4rpx; flex-shrink: 1; min-width: 0; max-width: 50%; }
.si-right .income-text,
.si-right .expense-text { font-size: 26rpx; word-break: break-all; }
.si-pct { font-size: 22rpx; color: var(--text-hint); }

.no-data { text-align: center; color: var(--text-hint); padding: 120rpx 0; font-size: 28rpx; }

/* ===== 趋势图 ===== */
.chart-card { padding: 24rpx 18rpx; }
.ch-label { font-size: 24rpx; color: var(--text-hint); margin-bottom: 8rpx; display: block; }
.trend-canvas { width: 100%; height: 360rpx; }
.ch-foot { display: flex; justify-content: space-between; margin-top: 14rpx; font-size: 24rpx; color: var(--text-hint); }
.chf-item { display: flex; align-items: center; gap: 8rpx; }
.dot { width: 14rpx; height: 14rpx; border-radius: 50%; }

/* ===== 钻取弹窗 ===== */
.drill-mask {
  position: fixed; inset: 0; background: rgba(0,0,0,.5);
  z-index: 100; animation: fadeIn .3s var(--ease-out);
  backdrop-filter: blur(4rpx);
}
.drill-panel {
  position: fixed; left: 20rpx; right: 20rpx; top: 10%; bottom: 10%;
  background: var(--card); border-radius: var(--radius-lg); z-index: 101;
  display: flex; flex-direction: column; overflow: hidden;
  box-shadow: var(--shadow-lg);
  animation: scaleIn .35s var(--ease-spring);
}
.dp-head {
  display: flex; align-items: center;
  padding: 28rpx 24rpx 18rpx; border-bottom: 1rpx solid var(--divider);
  overflow: hidden;
}
.dp-title { font-size: 32rpx; font-weight: 700; flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.dp-total { font-size: 24rpx; margin-right: 16rpx; flex-shrink: 0; white-space: nowrap; }
.dp-base-hint { font-size: 20rpx; color: var(--text-hint); flex-shrink: 0; margin-right: 10rpx; white-space: nowrap; }
.dp-close { font-size: 32rpx; color: var(--text-hint); padding: 10rpx; transition: color .2s; }
.dp-close:active { color: var(--text); }
.dp-list { flex: 1; height: 0; padding: 8rpx 50rpx 8rpx 20rpx; }
.dp-item {
  display: flex; align-items: center; gap: 16rpx;
  padding: 20rpx 0; border-bottom: 1rpx solid var(--divider);
  transition: background .2s; overflow: hidden;
}
.dp-item:active { background: var(--card-hover); }
.dpi-icon { font-size: 32rpx; width: 44rpx; flex-shrink: 0; }
.dpi-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; overflow: hidden; }
.dpi-date { font-size: 26rpx; color: var(--text-secondary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.dpi-note { font-size: 24rpx; color: var(--text-hint); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.dpi-amount { font-size: 26rpx; font-weight: 600; flex-shrink: 0; white-space: nowrap; text-align: right; margin-right: 22rpx; }
.dp-empty { text-align: center; color: var(--text-hint); padding: 80rpx 0; font-size: 26rpx; }
