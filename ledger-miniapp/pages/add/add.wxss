.container { min-height: 100vh; background: var(--bg); padding: 24rpx; }

/* ===== 类型切换 ===== */
.switch-bar {
  display: flex; background: var(--divider); border-radius: var(--radius-full);
  padding: 6rpx; margin-bottom: 32rpx;
}
.sw-btn {
  flex: 1; text-align: center; padding: 18rpx; border-radius: 32rpx;
  font-size: 30rpx; font-weight: 600; color: var(--text-hint);
  transition: all .3s var(--ease);
}
.sw-expense {
  background: linear-gradient(135deg, #C62828, #E53935);
  color: #fff; box-shadow: 0 6rpx 20rpx rgba(198,40,40,.3);
  transform: scale(1.02);
}
.sw-income {
  background: linear-gradient(135deg, var(--primary-light), var(--primary-mid));
  color: #fff; box-shadow: 0 6rpx 20rpx rgba(46,125,50,.3);
  transform: scale(1.02);
}

/* ===== 金额输入 ===== */
.amt-box {
  display: flex; align-items: center; justify-content: center;
  padding: 56rpx 0 44rpx; margin-bottom: 24rpx;
  border-bottom: 4rpx solid var(--divider);
  transition: border-color .3s;
}
.amt-expense { border-color: var(--danger); }
.amt-expense .amt-symbol { color: var(--danger); }
.amt-income { border-color: var(--primary-mid); }
.amt-income .amt-symbol { color: var(--primary-mid); }
.amt-symbol { font-size: 52rpx; font-weight: 800; margin-right: 10rpx; transition: color .3s; }
.amt-input { font-size: 56rpx; font-weight: 800; width: 420rpx; line-height: 1.4; }

/* ===== 货币选择 ===== */
.currency-section { text-align: center; margin-bottom: 24rpx; animation: fadeIn .3s var(--ease-out); }
.currency-pick {
  display: inline-block; font-size: 26rpx; color: var(--primary-light);
  background: var(--primary-bg); padding: 10rpx 28rpx;
  border-radius: var(--radius-full); font-weight: 500;
  transition: all .2s;
}
.currency-pick:active { background: var(--primary-soft); }
.conv-preview { margin-top: 14rpx; font-size: 28rpx; color: var(--accent); font-weight: 600; animation: fadeInUp .3s var(--ease-out); }
.conv-note { font-size: 22rpx; color: var(--text-hint); font-weight: 400; }

/* ===== 分类 ===== */
.section { margin-bottom: 24rpx; }
.sec-label { font-size: 26rpx; color: var(--text-hint); margin-bottom: 16rpx; display: block; font-weight: 500; }
.cate-grid { display: flex; flex-wrap: wrap; gap: 12rpx; }
.cate-chip {
  display: flex; align-items: center; gap: 8rpx;
  padding: 14rpx 24rpx; background: var(--bg); border-radius: 28rpx;
  font-size: 27rpx; color: var(--text-secondary); border: 2rpx solid transparent;
  transition: all .25s var(--ease);
}
.cate-chip:active { transform: scale(.95); }
.chip-icon { font-size: 30rpx; }
.chip-expense {
  border-color: var(--danger); color: var(--danger);
  background: var(--danger-light); font-weight: 600;
}
.chip-income {
  border-color: var(--primary-mid); color: var(--primary-mid);
  background: var(--primary-bg); font-weight: 600;
}

/* ===== 字段 ===== */
.field {
  display: flex; justify-content: space-between; align-items: center;
  background: var(--card); padding: 24rpx 20rpx;
  border-radius: var(--radius-sm); margin-bottom: 10rpx;
  box-shadow: var(--shadow-xs); transition: background .2s;
}
.field:active { background: var(--card-hover); }
.field-label { font-size: 28rpx; color: var(--text-secondary); }
.field-val { font-size: 28rpx; color: var(--text); }
.field-inp { text-align: right; font-size: 28rpx; width: 360rpx; }

/* ===== 提交按钮 ===== */
.submit {
  width: 100%; color: #fff; font-size: 36rpx; font-weight: 700;
  border-radius: var(--radius); margin-top: 44rpx;
  padding: 16rpx 0; letter-spacing: 6rpx;
  transition: all .3s var(--ease);
}
.sub-expense {
  background: linear-gradient(135deg, #C62828, #E53935);
  box-shadow: 0 8rpx 24rpx rgba(198,40,40,.35);
}
.sub-income {
  background: linear-gradient(135deg, var(--primary-light), #43A047);
  box-shadow: 0 8rpx 24rpx rgba(46,125,50,.35);
}
.submit:active { transform: scale(.97); opacity: .9; }
.submit[disabled] { background: var(--divider); color: var(--text-hint); letter-spacing: 0; box-shadow: none; }
