.page-root { min-height: 100vh; background: var(--bg); }
.login-wrap { padding: 60rpx 40rpx; }

/* logo */
.logo-area { display: flex; flex-direction: column; align-items: center; margin-bottom: 50rpx; }
.logo-icon { font-size: 100rpx; margin-bottom: 16rpx; }
.logo-title { font-size: 44rpx; font-weight: 800; color: var(--text); }
.logo-sub { font-size: 26rpx; color: var(--text-hint); margin-top: 8rpx; }

/* 卡片 */
.card { background: var(--card); border-radius: var(--radius-lg); padding: 36rpx 30rpx; box-shadow: var(--shadow-sm); }
.card-title { font-size: 30rpx; font-weight: 700; display: block; margin-bottom: 24rpx; color: var(--text); }

/* 头像 */
.avatar-row { display: flex; align-items: center; gap: 20rpx; margin-bottom: 24rpx; }
.avatar-btn {
  width: 100rpx; height: 100rpx; border-radius: 50%; overflow: hidden;
  background: var(--bg); padding: 0; margin: 0;
  display: flex; align-items: center; justify-content: center;
  border: 3rpx solid var(--primary-soft);
}
.avatar-btn::after { border: none; }
.av-img { width: 100%; height: 100%; }
.av-placeholder { font-size: 50rpx; }
.av-hint { font-size: 24rpx; color: var(--text-hint); }

/* 输入 */
.name-inp {
  width: 100%; font-size: 30rpx; color: var(--text); line-height: 1.4;
  background: var(--bg); border-radius: var(--radius-sm);
  padding: 24rpx 20rpx; margin-bottom: 20rpx; box-sizing: border-box;
  min-height: 88rpx;
}
.name-inp::placeholder { color: var(--text-hint); }

/* 导入游客数据勾选 */
.import-row { display: flex; align-items: center; gap: 12rpx; margin-bottom: 28rpx; padding: 8rpx 0; }
.import-check { font-size: 32rpx; flex-shrink: 0; }
.import-label { font-size: 26rpx; color: var(--text-secondary); }

/* 按钮 */
.btn-create {
  width: 100%; height: 88rpx; line-height: 88rpx; font-size: 32rpx;
  font-weight: 700; color: #fff; border-radius: var(--radius);
  background: linear-gradient(135deg, var(--primary-light), var(--primary-mid));
  box-shadow: 0 6rpx 20rpx rgba(46,125,50,.25);
}
.btn-create::after { border: none; }
.btn-create:active { opacity: .85; }

/* 账号列表 */
.account-item {
  display: flex; align-items: center; gap: 16rpx;
  padding: 22rpx 0; border-bottom: 1rpx solid var(--divider);
  transition: background .2s;
}
.account-item:active { background: var(--card-hover); }
.ai-avatar { width: 72rpx; height: 72rpx; border-radius: 50%; flex-shrink: 0; }
.ai-avatar-text { font-size: 44rpx; width: 72rpx; text-align: center; flex-shrink: 0; }
.ai-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.ai-name { font-size: 30rpx; font-weight: 600; color: var(--text); }
.ai-time { font-size: 22rpx; color: var(--text-hint); }
.ai-del { font-size: 28rpx; padding: 8rpx; flex-shrink: 0; }

/* 当前账号 */
.active-account { display: flex; align-items: center; gap: 16rpx; margin-bottom: 16rpx; }
.aa-avatar { width: 72rpx; height: 72rpx; border-radius: 50%; flex-shrink: 0; }
.aa-avatar-text { font-size: 44rpx; flex-shrink: 0; }
.aa-info { flex: 1; display: flex; flex-direction: column; gap: 4rpx; }
.aa-name { font-size: 30rpx; font-weight: 600; color: var(--text); }
.aa-status { font-size: 22rpx; color: var(--primary-mid); }
.aa-actions { display: flex; }
.aaa-btn { font-size: 26rpx; padding: 10rpx 24rpx; border-radius: var(--radius-sm); }
.aaa-logout { color: var(--text-secondary); background: var(--divider); }

/* 游客提示 */
.guest-hint { font-size: 26rpx; color: var(--text-hint); line-height: 1.6; }

/* 新建账号行 */
.add-row { display: flex; align-items: center; gap: 12rpx; padding: 24rpx 0 6rpx; }
.add-icon { font-size: 36rpx; color: var(--primary-light); }
.add-text { font-size: 28rpx; color: var(--primary-light); font-weight: 600; }

/* 返回按钮 */
.back-row { text-align: center; margin-top: 30rpx; padding: 20rpx; }
.back-text { font-size: 28rpx; color: var(--text-secondary); }
