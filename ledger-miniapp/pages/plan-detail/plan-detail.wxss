.wrap { min-height: 100vh; background: var(--bg); padding: 24rpx 24rpx 60rpx; }

/* ===== 顶部卡片 ===== */
.header-card {
  background: var(--card); border-radius: var(--radius);
  padding: 44rpx 30rpx; display: flex; flex-direction: column;
  align-items: center; margin-bottom: 20rpx;
  box-shadow: var(--shadow-sm);
  animation: fadeInUp .4s var(--ease-out) both;
}
.hc-edit { border: 3rpx solid var(--accent); background: #FFF8E1; }
.edit-badge {
  font-size: 22rpx; color: #E65100; background: #FFF3E0;
  padding: 6rpx 20rpx; border-radius: var(--radius-full);
  margin-bottom: 16rpx; font-weight: 600;
}
.method-icon-big {
  width: 110rpx; height: 110rpx; border-radius: 28rpx;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 24rpx;
}
.method-icon-big text { font-size: 56rpx; }
.name-input {
  width: 100%; text-align: center; font-size: 34rpx;
  color: var(--text); background: transparent; margin-bottom: 12rpx;
}
.name-input::placeholder { color: var(--text-hint); }
.note-input { width: 100%; text-align: center; font-size: 28rpx; color: var(--text-secondary); background: transparent; }
.note-input::placeholder { color: var(--text-hint); }

/* ===== 表单卡片 ===== */
.form-card {
  background: var(--card); border-radius: var(--radius);
  padding: 0 28rpx; margin-bottom: 20rpx;
  box-shadow: var(--shadow-sm);
  animation: fadeInUp .4s var(--ease-out) .1s both;
}
.form-row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 26rpx 0; border-bottom: 1rpx solid var(--divider);
  transition: background .2s;
}
.form-row:active { background: var(--card-hover); margin: 0 -28rpx; padding: 26rpx 28rpx; }
.form-row:last-child { border-bottom: none; }
.form-label { font-size: 29rpx; color: var(--text-secondary); flex-shrink: 0; min-width: 0; }
.form-value { flex: 1; text-align: right; font-size: 29rpx; color: var(--primary-light); background: transparent; margin-left: 20rpx; }
.form-value::placeholder { color: var(--text-hint); }
.picker-value { font-size: 29rpx; color: var(--primary-light); }
.picker-value.placeholder { color: var(--text-hint); }

/* ===== 说明文字 ===== */
.summary-text {
  display: block; font-size: 24rpx; color: var(--text-hint);
  line-height: 1.7; margin-bottom: 24rpx; padding: 0 4rpx;
}

/* ===== 保存按钮 ===== */
.btn-save {
  width: 100%; color: #fff; border-radius: var(--radius);
  font-size: 34rpx; font-weight: 700; height: 92rpx; line-height: 92rpx;
  margin-bottom: 36rpx; letter-spacing: 4rpx;
  background: linear-gradient(135deg, var(--primary-light), var(--primary-mid));
  box-shadow: 0 8rpx 24rpx rgba(46,125,50,.3);
  transition: all .2s;
}
.btn-save:active { opacity: .85; transform: scale(.98); }
.btn-save::after { border: none; }
.btn-update { background: linear-gradient(135deg, #FF9800, #F57C00); box-shadow: 0 8rpx 24rpx rgba(255,152,0,.3); }

/* ===== 已有计划列表 ===== */
.list-card {
  background: var(--card); border-radius: var(--radius);
  padding: 28rpx; box-shadow: var(--shadow-sm);
  animation: fadeInUp .4s var(--ease-out) .2s both;
}
.list-title { display: block; font-size: 30rpx; font-weight: 700; color: var(--text); margin-bottom: 20rpx; }
.plan-item { padding: 22rpx 0; border-bottom: 1rpx solid var(--divider); transition: background .2s; }
.plan-item:active { background: var(--card-hover); }
.plan-item:last-child { border-bottom: none; }
.plan-head { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 14rpx; }
.plan-name { display: block; font-size: 28rpx; font-weight: 600; color: var(--text); }
.plan-sub { display: block; font-size: 22rpx; color: var(--text-hint); margin-top: 4rpx; }
.plan-del { font-size: 24rpx; color: #FF5252; flex-shrink: 0; padding: 4rpx 10rpx; transition: opacity .2s; }
.plan-del:active { opacity: .6; }
.progress-bar { height: 12rpx; background: #EEE; border-radius: 6rpx; overflow: hidden; margin-bottom: 12rpx; }
.progress-fill { height: 100%; background: linear-gradient(90deg, #43A047, #66BB6A); border-radius: 6rpx; transition: width .5s var(--ease-out); }
.plan-foot { display: flex; justify-content: space-between; align-items: center; }
.plan-progress { font-size: 24rpx; color: var(--text-hint); }
.plan-save-btn {
  font-size: 24rpx; color: #fff; background: var(--primary-mid);
  padding: 10rpx 28rpx; border-radius: var(--radius-full);
  transition: all .2s;
}
.plan-save-btn:active { opacity: .8; transform: scale(.95); }

/* ===== 灵活存钱弹窗 ===== */
.deposit-mask {
  position: fixed; inset: 0; background: rgba(0,0,0,.5);
  z-index: 300; animation: fadeIn .25s;
  backdrop-filter: blur(4rpx);
}
.deposit-dlg {
  position: fixed; top: 35%; left: 50%; transform: translate(-50%,-50%);
  background: var(--card); border-radius: var(--radius-lg);
  padding: 36rpx; width: 560rpx; z-index: 301;
  box-shadow: var(--shadow-lg);
  animation: scaleIn .3s var(--ease-spring);
}
.dd-title { font-size: 32rpx; font-weight: 700; display: block; text-align: center; margin-bottom: 8rpx; }
.dd-hint { font-size: 24rpx; color: var(--text-hint); display: block; text-align: center; margin-bottom: 24rpx; }
.dd-input-row { display: flex; align-items: center; justify-content: center; margin-bottom: 28rpx; border-bottom: 3rpx solid var(--primary-mid); padding-bottom: 10rpx; }
.dd-symbol { font-size: 44rpx; font-weight: 800; margin-right: 8rpx; color: var(--text); }
.dd-input { font-size: 44rpx; font-weight: 800; width: 320rpx; text-align: center; color: var(--text); }
.dd-input::placeholder { color: var(--text-hint); }
.dd-btns { display: flex; gap: 16rpx; }
.dd-btns button { flex: 1; font-size: 28rpx; border-radius: var(--radius-sm); padding: 12rpx 0; transition: all .2s; }
.dd-btns button:active { transform: scale(.96); }
.dd-btn-cancel { background: var(--divider); color: var(--text-secondary); }
.dd-btn-ok { background: linear-gradient(135deg, var(--primary-light), var(--primary-mid)); color: #fff; }
